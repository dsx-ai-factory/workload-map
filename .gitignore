cover.out
.DS_Store

bin/
testbin/
vendor/

# The modules reach each other through replace directives, not a workspace.
go.work
go.work.sum

# Test binary, build with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Kubernetes Generated files - skip generated files, except for vendored files
!vendor/**/zz_generated.*
config/crd/_.yaml

# editor and IDE
*.iml
*.swp
*.swo
*~
.vscode/
.idea
/docs/examples/quickstart/quickstart

# Generated air-gap image locks (make image-lock)
/dist/

# Packaged Helm charts
/charts/*.tgz

# built hack tool binaries, named after their directory by `go build`
/hack/imagelock/imagelock
/hack/release/release

# Generated WASM engine build artifacts (make headlamp-plugin-wasm)
/karta-wasm/karta.wasm
/karta-wasm/wasm_exec.js

hack/e2e/operators/.installed-versions*

# Diagnostics collected by hack/e2e/karta-operator/test.sh
/.artifacts/
