          "editorMode": "code",
          "expr": "topk(10, (sum by (namespace, workload_name, workload_uid) (label_replace(((max by (namespace, pod, container, id) (rate(container_cpu_usage_seconds_total{job=~\"${cadvisor_job:regex}\", namespace=~\"${namespace:regex}\", pod!=\"\", container!=\"\", container!=\"POD\"}[5m])) == min by (namespace, pod, container, id) (rate(container_cpu_usage_seconds_total{job=~\"${cadvisor_job:regex}\", namespace=~\"${namespace:regex}\", pod!=\"\", container!=\"\", container!=\"POD\"}[5m])))) and on (namespace, pod, container) (count by (namespace, pod, container) ((max by (namespace, pod, container, id) (rate(container_cpu_usage_seconds_total{job=~\"${cadvisor_job:regex}\", namespace=~\"${namespace:regex}\", pod!=\"\", container!=\"\", container!=\"POD\"}[5m])) == min by (namespace, pod, container, id) (rate(container_cpu_usage_seconds_total{job=~\"${cadvisor_job:regex}\", namespace=~\"${namespace:regex}\", pod!=\"\", container!=\"\", container!=\"POD\"}[5m])))) == 1), \"pod_name\", \"$1\", \"pod\", \"(.+)\") * on (namespace, pod_name) group_left (workload_name, workload_uid) (dsx:pod_attribution:unique{job=~\"${exporter_job:regex}\", namespace=~\"${namespace:regex}\", observation_valid=\"true\"}))) and on () (min(up{job=~\"${exporter_job:regex}\"}) == 1) and on () (min(up{job=~\"${cadvisor_job:regex}\"}) == 1))",
