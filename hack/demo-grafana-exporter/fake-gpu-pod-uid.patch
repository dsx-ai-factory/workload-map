@@ -0,0 +1,61 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 NVIDIA Corporation
+
+package metrics
+
+import (
+	"github.com/prometheus/client_golang/prometheus"
+	dto "github.com/prometheus/client_model/go"
+	"github.com/run-ai/fake-gpu-operator/internal/common/constants"
+	"github.com/run-ai/fake-gpu-operator/internal/common/topology"
+	"github.com/spf13/viper"
+	"k8s.io/apimachinery/pkg/types"
+	"testing"
+)
+
+func TestExportsAllocatedPodUID(t *testing.T) {
+	viper.Set(constants.EnvNodeName, "test-node")
+	defer viper.Reset()
+	topo := &topology.NodeTopology{GpuMemory: 16000, GpuProduct: "Test-GPU", Gpus: []topology.GpuDetails{{ID: "GPU-1", Status: topology.GpuStatus{
+		AllocatedBy:       topology.ContainerDetails{Namespace: "test", Pod: "gpu-pod", PodUID: "actual-pod-uid", Container: "worker"},
+		PodGpuUsageStatus: topology.PodGpuUsageStatusMap{types.UID("consumer-uid"): {Utilization: topology.Range{Min: 80, Max: 80}, FbUsed: 4000}},
+	}}}}
+	exporter := &MetricsExporter{}
+	if err := exporter.export(topo); err != nil {
+		t.Fatal(err)
+	}
+	labels := prometheus.Labels{"gpu": "0", "UUID": "GPU-1", "device": "nvidia0", "modelName": "Test-GPU", "Hostname": generateFakeHostname("test-node"), "namespace": "test", "pod": "gpu-pod", "pod_uid": "actual-pod-uid", "container": "worker"}
+	for _, tc := range []struct {
+		name  string
+		gauge *prometheus.GaugeVec
+		want  float64
+	}{{"util", gpuUtilization, 80}, {"used", gpuFbUsed, 4000}, {"free", gpuFbFree, 12000}} {
+		metric := &dto.Metric{}
+		if err := tc.gauge.With(labels).Write(metric); err != nil {
+			t.Fatal(err)
+		}
+		if got := metric.GetGauge().GetValue(); got != tc.want {
+			t.Errorf("%s = %v, want %v", tc.name, got, tc.want)
+		}
+	}
+	topo.Gpus[0].Status.AllocatedBy.PodUID = ""
+	if err := exporter.export(topo); err != nil {
+		t.Fatal(err)
+	}
+	families, err := prometheus.DefaultGatherer.Gather()
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, family := range families {
+		if family.GetName() != "DCGM_FI_DEV_GPU_UTIL" {
+			continue
+		}
+		for _, metric := range family.Metric {
+			for _, label := range metric.Label {
+				if label.GetName() == "pod_uid" && label.GetValue() != "" {
+					t.Fatalf("unknown allocated UID was invented: %q", label.GetValue())
+				}
+			}
+		}
+	}
+}
