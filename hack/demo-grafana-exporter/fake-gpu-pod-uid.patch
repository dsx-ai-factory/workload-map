+++ b/internal/status-updater/handlers/pod/pod_uid_test.go
@@ -0,0 +1,30 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 NVIDIA Corporation
+
+package pod
+
+import (
+	. "github.com/onsi/ginkgo/v2"
+	. "github.com/onsi/gomega"
+	"github.com/run-ai/fake-gpu-operator/internal/common/topology"
+	corev1 "k8s.io/api/core/v1"
+	"k8s.io/apimachinery/pkg/api/resource"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+)
+
+var _ = Describe("Allocated Pod UID", func() {
+	It("retains physical Pod identity on allocation and annotation updates", func() {
+		pod := &corev1.Pod{ObjectMeta: metav1.ObjectMeta{Namespace: "test", Name: "gpu-pod", UID: "physical-pod-uid", Annotations: map[string]string{"run.ai/simulated-gpu-utilization": "80"}}, Spec: corev1.PodSpec{NodeName: "worker", Containers: []corev1.Container{{Name: "main", Resources: corev1.ResourceRequirements{Limits: corev1.ResourceList{"nvidia.com/gpu": resource.MustParse("1")}}}}}, Status: corev1.PodStatus{Phase: corev1.PodRunning}}
+		topo := &topology.NodeTopology{GpuMemory: 16000, Gpus: []topology.GpuDetails{{ID: "GPU-1", Status: topology.GpuStatus{PodGpuUsageStatus: topology.PodGpuUsageStatusMap{}}}}}
+		handler := &PodHandler{}
+		Expect(handler.handleDedicatedGpuPodAddition(pod, topo)).To(Succeed())
+		Expect(topo.Gpus[0].Status.AllocatedBy.PodUID).To(Equal(string(pod.UID)))
+		topo.Gpus[0].Status.AllocatedBy.PodUID = ""
+		Expect(handler.handleDedicatedGpuPodAddition(pod, topo)).To(Succeed())
+		Expect(topo.Gpus[0].Status.AllocatedBy.PodUID).To(Equal(string(pod.UID)))
+		pod.Annotations["run.ai/simulated-gpu-utilization"] = "2"
+		Expect(handler.handleDedicatedGpuPodUpdate(pod, topo)).To(Succeed())
+		Expect(topo.Gpus[0].Status.AllocatedBy.PodUID).To(Equal(string(pod.UID)))
+		Expect(topo.Gpus[0].Status.PodGpuUsageStatus[pod.UID].Utilization.Min).To(Equal(2))
+	})
+})
