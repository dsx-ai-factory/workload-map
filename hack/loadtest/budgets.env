#
# Pass/fail budgets for each tier. First values: set them again after the first
# 10k and 50k runs. A budget that fails makes report.sh exit 1.
#   SYNC        create done -> every load Pod has a dsx_workload_pod_info row (s)
#   MEMORY      exporter working set, max during steady (bytes)
#   SCRAPE      max scrape_duration_seconds during steady (s); below the scrape timeout
#   DRAIN       churn stops -> workqueues empty and rows match Pods again (s)
#   API_RPS     exporter API requests per second, mean during steady
#   RECOVER     exporter restart -> every load Pod has a row again (s)
# shellcheck disable=SC2034  # consumed by report.sh

case "${TIER}" in
  10k)  BUDGET_SYNC=120; BUDGET_MEMORY=$((512 * 1024 * 1024));  BUDGET_SCRAPE=5;  BUDGET_DRAIN=60;  BUDGET_API_RPS=20;  BUDGET_RECOVER=120 ;;
  50k)  BUDGET_SYNC=300; BUDGET_MEMORY=$((1536 * 1024 * 1024)); BUDGET_SCRAPE=10; BUDGET_DRAIN=120; BUDGET_API_RPS=20;  BUDGET_RECOVER=300 ;;
  150k) BUDGET_SYNC=900; BUDGET_MEMORY=$((4096 * 1024 * 1024)); BUDGET_SCRAPE=20; BUDGET_DRAIN=300; BUDGET_API_RPS=50;  BUDGET_RECOVER=900 ;;
esac

BUDGET_SYNC="${BUDGET_SYNC_OVERRIDE:-${BUDGET_SYNC:-300}}"
BUDGET_MEMORY="${BUDGET_MEMORY_OVERRIDE:-${BUDGET_MEMORY:-$((1536 * 1024 * 1024))}}"
BUDGET_SCRAPE="${BUDGET_SCRAPE_OVERRIDE:-${BUDGET_SCRAPE:-10}}"
BUDGET_DRAIN="${BUDGET_DRAIN_OVERRIDE:-${BUDGET_DRAIN:-120}}"
BUDGET_API_RPS="${BUDGET_API_RPS_OVERRIDE:-${BUDGET_API_RPS:-20}}"
BUDGET_RECOVER="${BUDGET_RECOVER_OVERRIDE:-${BUDGET_RECOVER:-300}}"
