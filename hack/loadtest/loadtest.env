# Scale test configuration and version pins. Every value is overridable from the
# environment or a make variable: make loadtest-run TIER=50k PHASES_CHURN_PERCENT=20.
# A variable name is the upper-case path of the setting, with _ between levels.
# tiers.env fills the SCALE_* and EXPORTER_* defaults of the selected TIER.

TIER="${TIER:-10k}"                                   # 10k | 50k | 150k | custom
# kind: up.sh creates a local kind cluster. existing: use the current kubectl context
# as is; you load the exporter image into its nodes (make loadtest-image prints how).
CLUSTER_MODE="${CLUSTER_MODE:-kind}"
CLUSTER_NAME="${CLUSTER_NAME:-karta-load}"            # kind mode only

# Share of Pods for each workload type, in percent; must sum to 100.
MIX_DEPLOYMENT="${MIX_DEPLOYMENT:-35}"                # Pod -> ReplicaSet -> Deployment
MIX_JOB="${MIX_JOB:-15}"                              # Pod -> Job
MIX_JOBSET="${MIX_JOBSET:-35}"                        # Pod -> Job -> JobSet
MIX_LWS="${MIX_LWS:-10}"                              # Pod -> StatefulSet -> (leader Pod ->) LeaderWorkerSet
MIX_POD="${MIX_POD:-5}"                               # bare Pod, the Pod is the root
PODS_PER_WORKLOAD="${PODS_PER_WORKLOAD:-4}"           # every type except bare Pods

# kube-burner client rate while it creates the roots (the load, not the exporter).
CREATE_QPS="${CREATE_QPS:-50}"
CREATE_BURST="${CREATE_BURST:-100}"

PHASES_START="${PHASES_START:-create}"                # create, or steady to reuse the workloads already there
PHASES_STEADY="${PHASES_STEADY:-600}"                 # seconds with no change
PHASES_CHURN_PERCENT="${PHASES_CHURN_PERCENT:-5}"     # of workload roots replaced each cycle
PHASES_CHURN_DELAY="${PHASES_CHURN_DELAY:-60}"        # seconds between cycle starts
PHASES_CHURN_DURATION="${PHASES_CHURN_DURATION:-900}" # seconds
PHASES_CHURN_FAIL_PERCENT="${PHASES_CHURN_FAIL_PERCENT:-1}"  # of Running Pods failed each cycle
PHASES_CHURN_CPU_PROFILE="${PHASES_CHURN_CPU_PROFILE:-120}"   # seconds of CPU profile from the first churn cycle
PHASES_RECOVER="${PHASES_RECOVER:-true}"              # restart the exporter and measure the second sync
PHASES_TIMEOUT="${PHASES_TIMEOUT:-3600}"              # seconds any wait may take before the run fails

EXPORTER_IMAGE="${EXPORTER_IMAGE:-dsx-workload-exporter:loadtest}"
EXPORTER_IMAGE_PLATFORM="${EXPORTER_IMAGE_PLATFORM:-linux/amd64}"  # existing mode: the node architecture
# GOMEMLIMIT of the exporter. "budget" is 90% of the memory budget of the tier, so the
# GC runs as in a Pod sized to that budget even when the container limit leaves room.
# "auto" is the chart default (90% of the container limit); a number of GiB is used as is.
EXPORTER_GO_MEM_LIMIT="${EXPORTER_GO_MEM_LIMIT:-budget}"
EXPORTER_PPROF="${EXPORTER_PPROF:-true}"              # run.sh saves heap, allocs and goroutine profiles per phase
EXPORTER_PPROF_PORT="${EXPORTER_PPROF_PORT:-16060}"   # local end of the profile port-forward
EXPORTER_SCRAPE_INTERVAL="${EXPORTER_SCRAPE_INTERVAL:-30s}"
EXPORTER_SCRAPE_TIMEOUT="${EXPORTER_SCRAPE_TIMEOUT:-25s}"

PROMETHEUS_PORT="${PROMETHEUS_PORT:-9090}"
RESULTS_DIR="${RESULTS_DIR:-results}"                 # relative to hack/loadtest

# Version pins.
KWOK_VERSION="${KWOK_VERSION:-v0.8.0}"
KUBE_BURNER_IMAGE="${KUBE_BURNER_IMAGE:-quay.io/kube-burner/kube-burner:v2.8.6}"
# Existing mode with a Prometheus operator already installed: up.sh uses that operator's
# chart version instead, so the Prometheus CR matches the installed CRDs.
KUBE_PROMETHEUS_STACK_VERSION="${KUBE_PROMETHEUS_STACK_VERSION:-92.1.0}"
WORKLOAD_IMAGE="${WORKLOAD_IMAGE:-registry.k8s.io/pause:3.10}"  # never pulled: KWOK Pods do not run
IMAGE_LOADER_IMAGE="${IMAGE_LOADER_IMAGE:-busybox:1.36.1}"    # image.sh: tar, gunzip and nsenter

# Namespaces.
LOAD_NAMESPACE_PREFIX="karta-load"                    # kube-burner creates karta-load-<n>
RUNNER_NAMESPACE="loadtest-runner"
MONITORING_NAMESPACE="${MONITORING_NAMESPACE:-loadtest-monitoring}"
MONITORING_RELEASE="${MONITORING_RELEASE:-loadtest}"  # its Prometheus selects ServiceMonitors with release=<this>
EXPORTER_NAMESPACE="karta-system"
EXPORTER_NAME="dsx-workload-exporter"
