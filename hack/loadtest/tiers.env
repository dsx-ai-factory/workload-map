#
# Tier defaults. The tier counts Pods, not workloads; 150k is the upstream
# per-cluster limit. The EXPORTER_* limits are first values: set them again after
# the first runs. Budgets for each tier live in budgets.env.
# shellcheck disable=SC2034  # consumed by the scripts that source this file

case "${TIER}" in
  10k)  _pods=10000;  _nodes=50;  _ns=20;  _qps=20;  _burst=40;  _workers=4;  _mem=2Gi ;;
  50k)  _pods=50000;  _nodes=250; _ns=100; _qps=50;  _burst=100; _workers=8;  _mem=4Gi ;;
  150k) _pods=150000; _nodes=750; _ns=300; _qps=100; _burst=200; _workers=16; _mem=8Gi ;;
  custom) : "${SCALE_PODS:?TIER=custom needs SCALE_PODS}" "${SCALE_NODES:?TIER=custom needs SCALE_NODES}" ;;
  *) echo "unknown TIER ${TIER}: use 10k, 50k, 150k or custom" >&2; return 1 2>/dev/null || exit 1 ;;
esac

SCALE_PODS="${SCALE_PODS:-${_pods:-}}"
SCALE_NODES="${SCALE_NODES:-${_nodes:-}}"
SCALE_NAMESPACES="${SCALE_NAMESPACES:-${_ns:-100}}"
SCALE_PODS_PER_NODE="${SCALE_PODS_PER_NODE:-200}"
EXPORTER_API_QPS="${EXPORTER_API_QPS:-${_qps:-50}}"
EXPORTER_API_BURST="${EXPORTER_API_BURST:-${_burst:-100}}"
EXPORTER_WORKERS="${EXPORTER_WORKERS:-${_workers:-8}}"
EXPORTER_MEMORY_LIMIT="${EXPORTER_MEMORY_LIMIT:-${_mem:-4Gi}}"
unset _pods _nodes _ns _qps _burst _workers _mem
