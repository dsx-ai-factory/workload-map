{
  "name": "karta",
  "version": "0.1.0",
  "description": "Headlamp plugin that visualizes Karta workload trees",
  "scripts": {
    "start": "headlamp-plugin start",
    "build": "headlamp-plugin build",
    "format": "headlamp-plugin format",
    "lint": "headlamp-plugin lint",
    "lint-fix": "headlamp-plugin lint --fix",
    "package": "headlamp-plugin package",
    "tsc": "headlamp-plugin tsc",
    "test": "headlamp-plugin test",
    "i18n": "headlamp-plugin i18n"
  },
  "keywords": [
    "headlamp",
    "headlamp-plugin",
    "kubernetes",
    "kubernetes-ui",
    "kubernetes-debugging",
    "plugins"
  ],
  "headlamp": {
    "extraDist": {
      "karta.wasm": "../karta-wasm/karta.wasm",
      "wasm_exec.js": "../karta-wasm/wasm_exec.js"
    }
  },
  "prettier": "@headlamp-k8s/eslint-config/prettier-config",
  "eslintConfig": {
    "extends": [
      "@headlamp-k8s",
      "prettier",
      "plugin:jsx-a11y/recommended"
    ]
  },
  "overrides": {
    "typescript": "5.6.2",
    "webpack-dev-middleware": "^7.4.6",
    "vitest": "^4.1.11",
    "@vitest/mocker": "^4.1.11",
    "@vitest/coverage-istanbul": "^4.1.11"
  },
  "devDependencies": {
    "@kinvolk/headlamp-plugin": "^0.14.0"
  }
}
